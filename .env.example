# Banco de dados (o compose ja sobe o Postgres com estas credenciais)
POSTGRES_DB=srag
POSTGRES_USER=srag
POSTGRES_PASSWORD=srag
SRAG_DATABASE_URL=postgresql+psycopg://srag:srag@db:5432/srag
# Papel somente leitura usado pelas ferramentas do agente
SRAG_DATABASE_URL_LEITURA=postgresql+psycopg://srag_leitura:leitura@db:5432/srag

# Gemini
GOOGLE_API_KEY=
SRAG_MODELO_LLM=gemini-3.8-flash
SRAG_MODELO_EMBEDDING=models/gemini-embedding-001
SRAG_DIMENSOES_EMBEDDING=768

# Limites por execucao (guardrail de custo)
SRAG_MAX_CHAMADAS_LLM=12
SRAG_MAX_TOKENS_EXECUCAO=120000

# Coleta de noticias
SRAG_NOTICIAS_MAX_ARTIGOS=15
SRAG_NOTICIAS_JANELA_DIAS=30
